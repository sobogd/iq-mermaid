# Local runtime config for iq-mermaid. Copy to .env (git-ignored) for
# `next dev`; in prod these are written to .env.production by deploy.yml from
# GitHub secrets (never committed). Only PORT is needed for a static build —
# everything else powers the account/auth + database feature.

# Server port (next start ignores PORT from .env, so it is passed inline).
PORT=8204

# Postgres for accounts + documents. Local dev reuses the same local Postgres
# as iq-rest (create a database first: `createdb iq_mermaid`).
# Prod points at the localhost-only Postgres on the shared VPS.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/iq_mermaid

# SMTP for the one-time sign-in code — Brevo's transactional relay
# (smtp-relay.brevo.com). The from-domain iq-mermaid.com must be authenticated
# in Brevo (DKIM/SPF), and the SMTP key below comes from
# Brevo dashboard → Settings → SMTP & API → SMTP keys.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# SMTP_USER is the Brevo account's SMTP login email (the address the Brevo
# account was created with); SMTP_PASS is an SMTP key (32-char alphanumeric) —
# NOT the API key and NOT a Gmail app password.
SMTP_USER=<brevo-login-email>
SMTP_PASS=<brevo-smtp-key>
# The "from" address shown on the OTP email — a sender on the authenticated
# iq-mermaid.com domain (here: the support mailbox).
FROM_EMAIL=support@iq-mermaid.com
