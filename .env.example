# Local runtime config for iq-mermaid. Copy to .env (git-ignored) for
# `next dev`; in prod these are written to .env.production by deploy.yml from
# GitHub secrets (never committed). Only PORT is needed for a static build —
# everything else powers the account/auth + database feature.

# Server port (next start ignores PORT from .env, so it is passed inline).
PORT=8204

# Postgres for accounts + documents. Local dev reuses the same local Postgres
# as iq-rest (create a database first: `createdb iq_mermaid`).
# Prod points at the localhost-only Postgres on the shared VPS.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/iq_mermaid

# SMTP for the one-time sign-in code (same box iq-rest uses).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@iq-rest.com
SMTP_PASS=
# The "from" address shown on the OTP email. iq-rest uses support@iq-rest.com;
# this app sends as noreply@iq-rest.com (must exist as a Workspace alias/mailbox).
FROM_EMAIL=noreply@iq-rest.com
